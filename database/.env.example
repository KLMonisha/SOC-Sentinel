# SOC Sentinel backend database settings (TEMPLATE, no real values).
# Copy to the backend's own .env (git-ignored) and fill in locally. Never commit the filled file.
# Role: soc_api (insert + select only; cannot update, delete or truncate evidence).

# Session-mode pooler (verified). Port 5432. Username is soc_api.<PROJECT_REF>.
# Use letters/digits only in the password, or URL-encode it.
DATABASE_URL=postgresql+psycopg://soc_api.<PROJECT_REF>:<SOC_API_PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require

# Keep the total pool at or below the role CONNECTION LIMIT (20) minus headroom.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true

# Never let the application create or alter tables: the schema is owned by supabase/migrations.
DB_AUTO_CREATE_TABLES=false

# Transaction-mode pooler (port 6543) would need prepared statements disabled; not used.
# Do NOT put the postgres admin password, the Supabase service-role key or the anon key here.
